{
  "manifest_version": 3,
  "name": "Charlie MJ Video Downloader",
  "version": "0.2.1",
  "description": "Detect authorized browser media and send stream metadata to Charlie MJ Video Downloader.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send to Charlie MJ"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
