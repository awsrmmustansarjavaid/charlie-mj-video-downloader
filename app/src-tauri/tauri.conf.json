{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Charlie MJ Video Downloader",
  "version": "0.2.0",
  "identifier": "com.charliemj.videodownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Charlie MJ Video Downloader",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://* data: blob:; img-src 'self' https: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "startMenuFolder": "Charlie MJ Video Downloader"
      }
    }
  }
}
